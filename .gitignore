# ============================================
# SECURITY: Environment Variables & Secrets
# ============================================
# Local environment files (содержат пароли, токены)
.env
.env.local
.env.*.local
*.env
!.env.example

# ============================================
# SECURITY: Firebase Credentials
# ============================================
# Firebase service account keys (приватные ключи)
firebase-service-account.json
**/firebase-service-account.json
firebase-adminsdk-*.json
**/firebase-adminsdk-*.json
google-services.json
GoogleService-Info.plist

# ============================================
