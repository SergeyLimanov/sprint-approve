# ============================================
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
*.truststore

# ============================================
# SECURITY: Database Backups & Dumps
# ============================================
*.sql.gz
*.sql.zip
*.dump
*.backup
/backups/
/dumps/

# ============================================
# SECURITY: Logs (могут содержать чувствительные данные)
# ============================================
*.log
logs/
*.log.*
/log/

# ============================================
# Docker & Kubernetes Secrets
# ============================================
docker-compose.override.yml
docker-compose.local.yml
*.secret.yml
secrets/
k8s-secrets/

